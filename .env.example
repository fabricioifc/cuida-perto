# Porta interna do servidor Node.js (execução standalone)
PORT=3000

# Ambiente de execução (development | production | test)
NODE_ENV=development

# Porta externa do proxy NGINX mapeada em 127.0.0.1 (Docker Compose)
WEB_PORT=8080

# Segredo para assinatura de cookies de sessão (em produção, use uma chave aleatória e segura)
SESSION_SECRET=cuidaperto_super_secret_local_dev_key_2026
