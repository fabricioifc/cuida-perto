<header class="site-header" role="banner">
  <div class="container header-container">
    <a href="/" class="brand-logo" aria-label="CuidaPerto - Página Inicial">
      <span class="logo-icon" aria-hidden="true">💙</span>
      <span class="logo-text">Cuida<span class="logo-accent">Perto</span></span>
    </a>

    <nav class="site-nav" role="navigation" aria-label="Menu principal">
      <ul class="nav-list">
        <li><a href="/" class="nav-link">Início</a></li>
        <li><a href="/search" class="nav-link">Buscar Cuidadores</a></li>
        <li><a href="#como-funciona" class="nav-link">Como Funciona</a></li>
      </ul>
    </nav>

    <div class="header-auth" role="navigation" aria-label="Conta do usuário">
      <% if (locals.currentUser) { %>
        <span class="header-username" aria-live="polite">
          Olá, <strong><%= currentUser.name.split(' ')[0] %></strong>
        </span>
        <form action="/auth/logout" method="POST" class="logout-form">
          <button type="submit" class="btn btn-outline btn-sm" aria-label="Sair da conta">
            Sair
          </button>
        </form>
      <% } else { %>
        <a href="/auth/login" class="btn btn-outline btn-sm">Entrar</a>
        <a href="/auth/cadastro/familia" class="btn btn-primary btn-sm">Cadastrar</a>
      <% } %>
    </div>
  </div>
</header>
